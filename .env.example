# Commerce Agent OS — Environment Variables

# Telegram
TOKEN=your_telegram_bot_token
OWNER_ID=your_telegram_id

# Eitaa
EITAA_TOKEN=your_eitaa_bot_token

# Rubika
RUBIKA_AUTH=your_rubika_auth_key
RUBIKA_PRIVATE_KEY=
RUBIKA_PHONE=

# Locale
BOT_LOCALE=fa

# Database
DATABASE_URL=postgresql+asyncpg://store:password@localhost:5432/commerce

# Redis
REDIS_URL=redis://localhost:6379

# Typesense
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=your_typesense_key

# Admin Panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
ADMIN_SECRET_KEY=change_me_secret_key
ADMIN_HOST=0.0.0.0
ADMIN_PORT=9090

# Webhook
WEBHOOK_ENABLED=0
WEBHOOK_URL=
WEBHOOK_SECRET=

# Debug
DEBUG=0
LOG_TO_STDOUT=1
